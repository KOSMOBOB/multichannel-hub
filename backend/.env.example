# Порт backend-сервиса
PORT=4000

# Подключение к PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multichannel?schema=public

# Redis для очередей BullMQ
REDIS_HOST=redis
REDIS_PORT=6379

# Секрет и срок жизни JWT-токенов
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Учётные данные администратора по умолчанию (создаются при первом запуске)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

# Разрешённые источники для CORS (через запятую)
CORS_ORIGIN=http://localhost:3000
